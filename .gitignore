# Helm root content. The .gitkeep files are tracked defaults; everything else
# is local content and must stay out of this repository.
/projects/*
!/projects/.gitkeep
# Domain knowledge: the shared packs below ship with the repository and travel
# with it; any other domain under /domains/ is this root's own -- private or
# company-specific -- and stays local. To ship a new pack, add it here.
/domains/*
!/domains/.gitkeep
!/domains/agent-autonomy/
!/domains/agent-messaging/
!/domains/architecture/
!/domains/branch-isolation/
!/domains/change-sizing/
!/domains/code-review/
!/domains/definition-of-done/
!/domains/driving-delegated-work/
!/domains/implementation-notes/
!/domains/model-selection/
!/domains/progress-reporting/
!/domains/pull-request-lifecycle/
!/domains/software-delivery/
!/domains/spec-driven-development/
!/domains/verification/
!/domains/work-decomposition/
# A configured agent profile is this machine's own (commands, credential
# passthrough) and never enters the repository.
/agents.json
/agents/*
!/agents/.gitkeep
/state/*
!/state/.gitkeep
# Root-local operator preferences: this installation's own default agent and
# model, the runtimes it will not pay to start, and any model-family/runtime
# restriction it has chosen. The schema, the CLI, the docs and the tests are
# tracked; one operator's answers are not, because committing them would ship
# one machine's cost policy to everybody who clones the repository.
/preferences.json
# Defensive coverage for worktrees if a caller places them at the root.
/worktrees/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/

# macOS
.DS_Store

# Helm's own state lock, which lands here whenever a command is run with the
# repository root as its state directory. Empty, private, and never content.
/.lock

# uv's resolved lockfile. This repository is a plain-stdlib tool with no
# runtime dependencies; the lockfile only appears when a test run is invoked
# through uv, and pinning it would claim a dependency set the code does not have.
/uv.lock
